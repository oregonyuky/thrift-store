# Public URL of the .NET API (admin/). ThriftStoreApi__BaseUrl is also accepted. Browsers load product images from it, so use HTTPS in production.
THRIFT_API_URL=http://localhost:5000/
# 32+ random characters; signs the store and /painel login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional: Instagram profile link and Graph API feed for the home page.
INSTAGRAM_URL=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Optional: where the legacy Razor admin panel lives (defaults to THRIFT_API_URL).
LEGACY_ADMIN_URL=
