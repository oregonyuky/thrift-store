# URL of the .NET API (admin/). Product photos are loaded from it by the browser.
THRIFT_API_URL=http://localhost:5000/
# 32+ random characters; signs the staff login cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional: where the legacy Razor panel lives (defaults to THRIFT_API_URL) and the store link in the top bar.
LEGACY_ADMIN_URL=
STOREFRONT_URL=
